# Copy to .env and fill in. The backend reads this file (backend/.env, if present, is overridden by it).

# ============================================
# SERVER
# ============================================
MONGODB_URI=mongodb://localhost:27017/job-automation
PORT=3000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ============================================
# AI (OpenAI) - https://platform.openai.com/api-keys
# ============================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ============================================
# JOB SEARCH
# ============================================
# JSearch (RapidAPI, free tier) - https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your-jsearch-api-key-from-rapidapi
JSEARCH_API_HOST=jsearch.p.rapidapi.com
# Comma-separated; searches are limited to the USA
JOB_KEYWORDS=Full Stack Developer,Node.js Developer,React Developer
JOB_LOCATIONS=Remote
FETCH_MAX_PAGES=2
# Optional: company boards to pull auto-apply jobs from (comma-separated slugs); built-in lists are used when unset
# GREENHOUSE_COMPANIES=stripe,discord
# LEVER_COMPANIES=palantir
# ASHBY_COMPANIES=openai,notion
# Optional: regex of job titles to keep from those boards
# ATS_TITLE_PATTERN=engineer|developer

# ============================================
# GMAIL (App Password: Google Account -> Security -> 2-Step Verification -> App passwords)
# ============================================
# Used for password-reset emails and the Recruiter Inbox (reads recruiter emails, sends your reviewed replies)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-letter-app-password
EMAIL_FROM=NextGen Apply <your-email@gmail.com>
# Recruiter Inbox: replies are only drafted; nothing is sent until you click Send in the app
RECRUITER_INBOX_ENABLED=true
RECRUITER_INBOX_POLL_MINUTES=5
# How far back the first check looks
RECRUITER_INBOX_LOOKBACK_DAYS=3

# ============================================
# APPLY QUEUE (Chrome extension flow)
# ============================================
# A daily list of matches the extension fills in your browser; you submit
APPLY_QUEUE_ENABLED=false
APPLY_QUEUE_TIME=08:30
APPLY_QUEUE_SIZE=10
APPLY_QUEUE_MIN_SCORE=70
# The app's "Open NextGen Chrome" button (set false to turn it off)
ALLOW_BROWSER_LAUNCH=true
# Optional: browser binary and profile folder for NextGen Chrome
# CHROME_PATH=
# NEXTGEN_CHROME_PROFILE=

# ============================================
# SERVER AUTOMATION (Puppeteer)
# ============================================
PUPPETEER_HEADLESS=false
# false = fill the form and wait for your Submit/Discard in the app; true = submit without review
AUTO_SUBMIT=false
# Daily autopilot: fetch -> match -> apply unattended to the best auto-apply matches (submits real applications)
AUTOPILOT_ENABLED=false
AUTOPILOT_TIME=09:00
AUTOPILOT_DAILY_LIMIT=10
AUTOPILOT_MIN_MATCH_SCORE=70
# Tabs stopped by a verification code / spam check stay open this long for you to finish
AUTOPILOT_ACTION_TIMEOUT_MINUTES=120
# Random wait between autopilot applications (rapid submits get flagged as spam)
AUTOPILOT_DELAY_MIN_SECONDS=120
AUTOPILOT_DELAY_MAX_SECONDS=300

# ============================================
# RESUME GENERATOR SERVICE (automation/)
# ============================================
AUTOMATION_PORT=3001
AUTOMATION_URL=http://localhost:3001
